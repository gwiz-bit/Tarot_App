# Both keys are server-only. Set false for zero external AI requests.
AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# balanced | groq_primary | gemini_primary
AI_ROUTING_MODE=balanced
# Demo forces balanced rotation and uses a shorter timeout.
DEMO_MODE=false
# Production debug is allowed only when DEMO_MODE and AI_DEBUG are both true.
AI_DEBUG=false
# Optional canonical origin behind a reverse proxy, e.g. https://your-domain.vn
APP_ORIGIN=
